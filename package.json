{
  "name": "mcpgw",
  "version": "0.1.0",
  "description": "Home cluster tool gateway: web search and fetch over MCP",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "MCPGW_LIVE=1 vitest run tests/live.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.13.17",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "undici": "^8.12.4",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
